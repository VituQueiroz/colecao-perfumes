# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings → API). Na Vercel, cadastre as mesmas variáveis em
# Settings → Environment Variables.
#
# A chave "anon" / "publishable" pode ficar no navegador: quem protege os dados
# são as regras de RLS. NUNCA use a chave service_role aqui.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable
